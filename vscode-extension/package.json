{
  "name": "flowchart-visualizer",
  "displayName": "Flowchart Visualizer",
  "description": "書いたコードの制御フローをエディタ上でフローチャートとして可視化する",
  "version": "0.1.0",
  "private": true,
  "publisher": "flowchart-visualizer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/vscode-extension/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowchart.generateFromFile",
        "title": "Flowchart: カーソル位置の関数からフローチャートを生成"
      },
      {
        "command": "flowchart.generateFromSelection",
        "title": "Flowchart: 選択範囲からフローチャートを生成"
      },
      {
        "command": "flowchart.exportSvg",
        "title": "Flowchart: SVGとしてエクスポート"
      },
      {
        "command": "flowchart.exportPng",
        "title": "Flowchart: PNGとしてエクスポート"
      },
      {
        "command": "flowchart.copyMermaid",
        "title": "Flowchart: Mermaidテキストをコピー"
      },
      {
        "command": "flowchart.generateMagicCircle",
        "title": "Flowchart: 魔方陣として書き出し(エンタメ)"
      },
      {
        "command": "flowchart.diffAgainstHead",
        "title": "Flowchart: HEAD とのフロー差分を表示"
      },
      {
        "command": "flowchart.loadArchitecture",
        "title": "Flowchart: CodeBoarding の analysis.json を読み込む(全体)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flowchart.generateFromFile"
        },
        {
          "command": "flowchart.generateFromSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "flowchart.exportSvg"
        },
        {
          "command": "flowchart.exportPng"
        },
        {
          "command": "flowchart.copyMermaid"
        },
        {
          "command": "flowchart.generateMagicCircle"
        },
        {
          "command": "flowchart.diffAgainstHead",
          "when": "editorLangId != ''"
        },
        {
          "command": "flowchart.loadArchitecture"
        }
      ],
      "editor/context": [
        {
          "command": "flowchart.generateFromFile",
          "group": "flowchart@1"
        },
        {
          "command": "flowchart.generateFromSelection",
          "when": "editorHasSelection",
          "group": "flowchart@2"
        },
        {
          "command": "flowchart.generateMagicCircle",
          "group": "flowchart@3"
        },
        {
          "command": "flowchart.diffAgainstHead",
          "group": "flowchart@4"
        }
      ]
    },
    "configuration": {
      "title": "Flowchart Visualizer",
      "properties": {
        "flowchart.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "ファイル保存時に自動でフローチャートを再生成する"
        },
        "flowchart.followCursor": {
          "type": "boolean",
          "default": false,
          "description": "カーソルのある関数が変わったら、図を自動で切り替える(図のパネルが開いているときだけ)"
        }
      }
    }
  },
  "scripts": {
    "fetch-wasm": "node scripts/fetch-wasm.js",
    "copy-bundle": "node scripts/copy-bundle.js",
    "compile": "node scripts/copy-bundle.js && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "postinstall": "node scripts/fetch-wasm.js",
    "package": "npm run fetch-wasm && npm run compile",
    "test": "npm run compile && node scripts/test-host-logic.js && node scripts/smoke-test-scanner.js",
    "test:integration": "npm run compile && node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  }
}
